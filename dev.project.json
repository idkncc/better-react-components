{
    "name": "better-react-components-stories",
    "globIgnorePaths": [
        "**/package.json",
        "**/tsconfig.json"
    ],
    "tree": {
        "$className": "DataModel",
        "ReplicatedStorage": {
            "$className": "ReplicatedStorage",
            "DevPackages": {
                "$path": "DevPackages"
            },
            "Packages": {
                "$path": "Packages"
            },

                "better-react-components": {
                    "$path": "src"
                }
        }
    }
}
